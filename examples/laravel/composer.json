{
    "name": "luroweb/ksef-foundry-laravel-example",
    "description": "Minimal Laravel app showing luroweb/laravel-ksef-foundry (TEST environment).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "luroweb/laravel-ksef-foundry": "@dev"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/laravel",
            "options": {
                "symlink": true,
                "versions": {
                    "luroweb/laravel-ksef-foundry": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/php",
            "options": {
                "symlink": true,
                "versions": {
                    "luroweb/ksef-foundry": "0.1.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit --testsuite default",
        "test:live": [
            "@putenv KSEF_LIVE_TEST=1",
            "phpunit --testsuite live"
        ]
    }
}
