<?xml version="1.0"?>
<ruleset name="KSeF Foundry Laravel">
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <file>src</file>
    <file>config</file>
    <file>tests</file>
    <exclude-pattern>tests/Fault/raw_server.php</exclude-pattern>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
