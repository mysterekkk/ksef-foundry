{
  "name": "@luroweb/ksef-foundry",
  "version": "0.1.0",
  "description": "TypeScript SDK for Poland's National e-Invoice System (KSeF API 2.0) by LuroWeb.",
  "license": "MIT",
  "author": "LuroWeb",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project contract --project fault --project invoice",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:fault": "vitest run --project fault",
    "test:live": "node scripts/run-live.mjs",
    "generate:types": "openapi-typescript ../../schemas/openapi/test.json -o src/generated/openapi.d.ts",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:invoice": "vitest run --project invoice"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "xml-crypto": "^6.4.0",
    "xmllint-wasm": "^5.3.0"
  },
  "peerDependencies": {
    "@peculiar/x509": "^1.12.0 || ^2.0.0 || ^3.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "@peculiar/x509": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": "true"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@peculiar/x509": "^3.1.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
