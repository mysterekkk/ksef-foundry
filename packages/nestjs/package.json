{
  "name": "@luroweb/nestjs-ksef-foundry",
  "version": "0.1.0",
  "description": "NestJS integration for the KSeF Foundry TypeScript SDK (KSeF API 2.0) by LuroWeb.",
  "license": "MIT",
  "author": "LuroWeb",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project default",
    "test:live": "node scripts/run-live.mjs",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@luroweb/ksef-foundry": ">=0.1.0 <1.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@luroweb/ksef-foundry": "*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/testing": "^11.2.10",
    "@peculiar/x509": "^3.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
