{
    "name": "luroweb/ksef-foundry",
    "description": "PHP client SDK for Poland's National e-Invoice System (KSeF) API 2.0: authentication (token + XAdES), encrypted online sessions, invoice download and queries.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ksef",
        "e-invoice",
        "faktura",
        "fa3",
        "poland",
        "xades",
        "sdk"
    ],
    "homepage": "https://github.com/mysterekkk/ksef-foundry",
    "authors": [
        {
            "name": "LuroWeb"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "php-http/discovery": "^1.19",
        "phpseclib/phpseclib": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "suggest": {
        "ext-curl": "Required by the built-in zero-dependency HTTP client (CurlHttpClient).",
        "guzzlehttp/guzzle": "Found by KsefClientBuilder::discoverHttpClient() and wrapped in a hardened adapter (no redirects, enforced timeouts, size cap)."
    },
    "autoload": {
        "psr-4": {
            "LuroWeb\\KsefFoundry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LuroWeb\\KsefFoundry\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,contract,fault,invoice",
        "test:unit": "phpunit --testsuite unit",
        "test:contract": "phpunit --testsuite contract",
        "test:fault": "phpunit --testsuite fault",
        "test:live": [
            "@putenv KSEF_LIVE_TEST=1",
            "phpunit --testsuite live"
        ],
        "stan": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse -c phpstan-tests.neon --memory-limit=1G"
        ],
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "test:invoice": "phpunit --testsuite invoice"
    },
    "scripts-descriptions": {
        "test": "Unit + contract + fault-injection tests (no network to KSeF).",
        "test:live": "LIVE TEST against api-test.ksef.mf.gov.pl (opt-in).",
        "check": "cs + stan + tests (without live).",
        "stan": "PHPStan: src at level max, tests at level 6."
    }
}
